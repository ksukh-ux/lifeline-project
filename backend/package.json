{
  "name": "lifeline-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b && node scripts/copy-schema.mjs",
    "start": "node dist/server.js",
